NODE_ENV=production
DATABASE_URL=postgresql://user:pass@localhost:5432/ssb360
REDIS_URL=redis://localhost:6379
ADMIN_USERNAME=admin
# Production requires ADMIN_PASSWORD_HASH. ADMIN_PASSWORD is development-only and must stay empty in production.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
KPI_API_URL=
KPI_API_TOKEN=
APPEALS_API_URL=
APPEALS_API_TOKEN=
QR_API_URL=
QR_API_TOKEN=

# Optional 3D Situatsion markaz vector style. Disabled when empty.
# Only HTTPS style/source hosts explicitly listed below can be exposed to the browser.
SITUATION_MAP_STYLE_URL=
SITUATION_MAP_STYLE_ALLOWED_HOSTS=
